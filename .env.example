# Copy this file to `.env` and fill in real values. Never commit `.env` (it is gitignored).
#
# ═══ Supabase DATABASE_URL (read this) ═══════════════════════════════════════
# Use the **Session pooler** URI from Supabase → Project Settings → Database.
# Do NOT use the "Direct connection" host `db.<ref>.supabase.co` for local dev or
# Vercel: it is often IPv6-only → Prisma P1001 "Can't reach database" and login fails.
# Pooler host looks like `...pooler.supabase.com` (sometimes port 6543).
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional: allow direct db.* URL (IPv6 / advanced only; not for typical Mac/Vercel)
# SPM_ALLOW_SUPABASE_DIRECT=1

# Auth.js (NextAuth v5) — required for sign-in. Generate a value with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional: explicit site URL (helps Auth.js behind proxies / Vercel)
# AUTH_URL=http://localhost:3000

# ─── Auth hardening (Task 9) ─────────────────────────────────────────────────
# POST /api/auth/* rate limit (sliding window per IP in Edge middleware).
# Defaults: 20 requests per 900 seconds (15 min).
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_SEC=900
#
# Optional: reject credential sign-in when User.emailVerified is null (no email
# sending is implemented yet — use only when you set emailVerified in DB).
# AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ─── Seed users (Task 4) — run: pnpm db:seed after pnpm db:deploy ─────────────
# One password for every org user (simplest for local dev):
SEED_DEFAULT_PASSWORD=
#
# Optional: override per user (id `user-nhan` → SEED_PASSWORD_NHAN, `user-pm` → SEED_PASSWORD_PM):
# SEED_PASSWORD_NHAN=
# SEED_PASSWORD_BEN=
# SEED_PASSWORD_ALEX=
# SEED_PASSWORD_SIMON=
# SEED_PASSWORD_PRIYA=
# SEED_PASSWORD_MARCUS=
# SEED_PASSWORD_ELENA=
# SEED_PASSWORD_YUKI=
# SEED_PASSWORD_PM=
